  "scripts": {
    "dev": "pnpm run --filter site dev",
    "build": "pnpm run --filter react-clipboardjs-copy build && npm run docs",
    "docs": "rimraf docs && pnpm run --filter site build",
    "build:examples": "pnpm run --filter \\ test",
    "test": "pnpm run --filter react-clipboardjs-copy test",
    "lint": "eslint --fix \"packages/*/src/**/*.{ts,tsx,js,jsx,mjs,vue,cjs}\" \"examples/*/src/**/*.{ts,tsx,js,jsx,mjs,vue,cjs}\" \"site/src/**/*.{ts,tsx,js,jsx,mjs,vue,cjs}\"",
    "lint:check": "eslint \"packages/*/src/**/*.{ts,tsx,js,jsx,mjs,vue,cjs}\" \"examples/*/src/**/*.{ts,tsx,js,jsx,mjs,vue,cjs}\" \"site/src/**/*.{ts,tsx,js,jsx,mjs,vue,cjs}\"",
    "fmt": "prettier --write \"./**/*.{ts,tsx,js,jsx,mjs,json,md,vue,cjs}\"",
    "fmt:check": "prettier --check \"./**/*.{ts,tsx,js,jsx,mjs,json,md,vue,cjs}\"",
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.2.1",
    "@commitlint/config-conventional": "^19.1.0",
    "@commitlint/prompt-cli": "^19.2.0",
