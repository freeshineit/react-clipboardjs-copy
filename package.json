    "@types/node": "^20.12.4",
    "@types/react": "^18.2.74",
    "@types/react-dom": "^18.2.24",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "eslint-config-xx": "^2.2.3",
    "husky": "^9.1.7",
    "only-allow": "^1.2.1",
    "postcss": "^8.4.38",
    "postcss-preset-env": "^9.5.4",
    "prettier": "^3.8.1",
    "pretty-quick": "^4.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rimraf": "^5.0.5",
    "sass": "^1.74.1",
    "terser": "^5.30.3",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.2",
    "typescript": "5.3.3"
  }
