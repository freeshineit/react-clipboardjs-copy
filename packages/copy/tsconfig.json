{
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "outDir": "./lib",
    "rootDirs": ["src"],
    "target": "es2015",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "declaration": false,
    "esModuleInterop": true,
    "importHelpers": true,
    "sourceMap": true,
    "typeRoots": ["./src/typings", "./node_modules/@types"],
    "lib": ["ES2016", "DOM"],
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["src", "jest.setup.ts", "jest.config.ts"],
  "exclude": ["node_modules", "lib", "es", "dist"]
}
